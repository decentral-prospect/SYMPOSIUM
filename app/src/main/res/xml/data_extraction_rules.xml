<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="first_party_telemetry.xml"/>
        <exclude domain="sharedpref" path="install_servers.xml"/>
        <exclude domain="sharedpref" path="install_servers_secure.xml"/>
        <exclude domain="sharedpref" path="install_servers_admin_secure_v2.xml"/>
        <exclude domain="sharedpref" path="conference_e2ee_secrets_v1.xml"/>
        <exclude domain="sharedpref" path="relay_tls_pin_trust_v1.xml"/>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="first_party_telemetry.xml"/>
        <exclude domain="sharedpref" path="install_servers.xml"/>
        <exclude domain="sharedpref" path="install_servers_secure.xml"/>
        <exclude domain="sharedpref" path="install_servers_admin_secure_v2.xml"/>
        <exclude domain="sharedpref" path="conference_e2ee_secrets_v1.xml"/>
        <exclude domain="sharedpref" path="relay_tls_pin_trust_v1.xml"/>
    </device-transfer>
</data-extraction-rules>
